@page
@model Stammzellen.Pages.Blog.LoginModel
@{
    ViewData["Title"] = "Admin Login";
}

<div class="main-content">
    <div class="section-padding contact-form" style="max-width: 400px; margin: 4rem auto;">
        <h2>Admin-Bereich Login</h2>
        <form method="post" class="minimal-form">
            <div asp-validation-summary="ModelOnly" style="color: red; margin-bottom: 1rem;"></div>
            <div class="form-group">
                <label>Administrator-Passwort:</label>
                <input type="password" asp-for="Passwort" required autofocus />
            </div>
            <button type="submit" class="btn-submit" style="width: 100%;">Anmelden</button>
        </form>
    </div>
</div>
