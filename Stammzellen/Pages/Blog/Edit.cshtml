@page
@model Stammzellen.Pages.Blog.EditModel
@{
    ViewData["Title"] = "Beitrag bearbeiten";
}

<div class="blog-header">
    <h1>Wissenschaftlichen Beitrag bearbeiten</h1>
    <p>Korrigieren oder ergänzen Sie die Inhalte des ausgewählten Blogposts.</p>
</div>

<div class="main-content">
    <div class="section-padding contact-form" style="max-width: 800px; margin: 0 auto;">
        <h2>Beitrag anpassen</h2>

        <form method="post" class="minimal-form">
            <div asp-validation-summary="ModelOnly" class="alert-info" style="color: red; border-left-color: red;"></div>

            <!-- WICHTIG: Die ID muss versteckt mitgesendet werden -->
            <input type="hidden" asp-for="BearbeiteterPost.Id" />
            <input type="hidden" asp-for="BearbeiteterPost.ErstelltAm" />

            <div class="form-group">
                <label asp-for="BearbeiteterPost.Titel">Titel:</label>
                <input asp-for="BearbeiteterPost.Titel" required />
                <span asp-validation-for="BearbeiteterPost.Titel" style="color: red; font-size: 0.85rem;"></span>
            </div>

            <div class="form-group">
                <label asp-for="BearbeiteterPost.Autor">Autor / Verfasser des Artikels:</label>
                <input asp-for="BearbeiteterPost.Autor" required placeholder="z. B. Dr. Max Mustermann" />
                <span asp-validation-for="BearbeiteterPost.Autor" style="color: red; font-size: 0.85rem;"></span>
            </div>

            <div class="form-group">
                <label asp-for="BearbeiteterPost.Inhalt">Inhalt:</label>
                <textarea asp-for="BearbeiteterPost.Inhalt" rows="10" required style="resize: vertical;"></textarea>
                <span asp-validation-for="BearbeiteterPost.Inhalt" style="color: red; font-size: 0.85rem;"></span>
            </div>

            <div style="display: flex; gap: 1rem; margin-top: 1rem;">
                <button type="submit" class="btn-submit">Änderungen speichern</button>
                <a href="/Blog/Index" class="btn-reset" style="line-height: 2.3; text-align: center;">Abbrechen</a>
            </div>
        </form>
    </div>
</div>
