<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Stammzellen</title>
    <!-- Bindet direkt und ohne Umwege deine site.css ein -->
    <link rel="stylesheet" href="/css/site.css" />
</head>
<body>
    <header>
        <nav class="navbar">
            <div class="nav-container">
                <a class="nav-logo" href="#home">Stammzellen Projekt</a>

                <button class="nav-toggle" id="js-nav-toggle" aria-label="Menü öffnen">
                    <span class="bar"></span>
                    <span class="bar"></span>
                    <span class="bar"></span>
                </button>

                <ul class="nav-menu" id="js-nav-menu">
                    <li><a class="nav-link" href="#home">Home</a></li>
                    <li><a class="nav-link" href="#ueber-uns">Über uns</a></li>
                    <li><a class="nav-link" href="#kontakt">Kontakt</a></li>
                    <li><a class="nav-link" href="#impressum">Impressum</a></li>
                    <li><a class="nav-link" href="#dsgvo">DSGVO</a></li>
                </ul>
            </div>
        </nav>
    </header>

    <main class="main-content">
        @RenderBody()
    </main>

    <footer class="footer">
        <p>&copy; @DateTime.Now.Year - Stammzellen - Wissenschaft & Zukunft</p>
    </footer>

    <script src="/js/site.js"></script>
</body>
</html>
